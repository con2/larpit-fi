{
  "name": "larpit-fi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3158",
    "build": "prisma contract emit && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:integration": "prisma contract emit && vitest run --config vitest.integration.config.ts",
    "email:dev": "npx email dev -d src/emails -p 3159",
    "contract:emit": "prisma contract emit",
    "db:plan": "prisma contract emit && prisma migration plan --name",
    "db:migrate": "prisma db migrate",
    "db:migrate:dev": "prisma db migrate --advance-ref db",
    "db:verify": "prisma db verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@con2/components": "github:con2/components#v5.1.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "@types/diff": "^7.0.2",
    "bootstrap": "^5.3.7",
    "csv": "^6.6.3",
    "diff": "^9.0.0",
    "dotenv": "17.4.2",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.2",
    "nodemailer": "^10.0.1",
    "p-limit": "^7.3.2",
    "pg": "8.22.0",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-email": "^6.9.5",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "rehype-external-links": "^3.0.0",
    "rehype-sanitize": "^6.0.0",
    "swagger-ui-dist": "^5.32.15",
    "underscore": "^1.13.7",
    "uuid": "^14.0.2",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.3.0",
    "@prisma/orm-toolchain": "8.0.0-rc.9",
    "@types/node": "^26.5.1",
    "@types/pg": "8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-dist": "^3.30.6",
    "@types/underscore": "^1.13.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prisma": "8.0.0-rc.13",
    "sass": "^1.104.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "glob": "^13.0.6",
    "nodemailer": "^10.0.1"
  },
  "license": "MIT",
  "prettier": {},
  "type": "module"
}
