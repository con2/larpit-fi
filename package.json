{
  "name": "larpit-fi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma migrate dev && prisma generate --no-hints && next dev --turbopack --port 3158",
    "build": "prisma generate --no-hints && next build",
    "start": "next start",
    "lint": "prisma generate --no-hints && eslint .",
    "test:integration": "prisma generate --no-hints && vitest run --config vitest.integration.config.ts",
    "email:dev": "npx email dev -d src/emails -p 3159",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:migrate": "prisma migrate deploy",
    "k8s:generate": "node --experimental-strip-types src/bin/manifest.mts",
    "k8s:secret": "node --experimental-strip-types src/bin/secret.mts",
    "k8s:dev": "npm run k8s:generate && npm run k8s:secret && skaffold dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@con2/components": "github:con2/components#v3.0.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@types/diff": "^7.0.2",
    "bootstrap": "^5.3.7",
    "csv": "^6.4.1",
    "diff": "^9.0.0",
    "next": "^16.2.12",
    "next-auth": "^4.24.13",
    "next-intl": "^4.3.4",
    "node-postgres": "^0.6.2",
    "nodemailer": "^9.0.3",
    "p-limit": "^7.0.0",
    "react": "^19.2.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.1",
    "react-email": "^6.9.1",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.2",
    "rehype-external-links": "^3.0.0",
    "rehype-sanitize": "^6.0.0",
    "swagger-ui-dist": "^5.32.1",
    "underscore": "^1.13.7",
    "uuid": "^14.0.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-dist": "^3.30.6",
    "@types/underscore": "^1.13.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prisma": "^7.4.0",
    "sass": "^1.90.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "glob": "^13.0.6",
    "nodemailer": "^9.0.3"
  },
  "license": "MIT",
  "prettier": {}
}
