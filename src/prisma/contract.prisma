// use prisma-8
namespace public {
  native_enum UserRole {
    NOT_VERIFIED = "NOT_VERIFIED"
    VERIFIED = "VERIFIED"
    MODERATOR = "MODERATOR"
    ADMIN = "ADMIN"
  }

  native_enum EditFormPreference {
    FULL = "FULL"
    COMPACT = "COMPACT"
  }

  native_enum TokenType {
    EMAIL_VERIFICATION = "EMAIL_VERIFICATION"
    ACCOUNT_REMOVAL = "ACCOUNT_REMOVAL"
  }

  native_enum LarpType {
    ONE_SHOT = "ONE_SHOT"
    CAMPAIGN_LARP = "CAMPAIGN_LARP"
    // of CAMPAIGN_LARPs
    CAMPAIGN = "CAMPAIGN"
    // of ONE_SHOTs (or, in rare occasions, CAMPAIGNs)
    MULTIPLE_RUNS = "MULTIPLE_RUNS"
    OTHER_EVENT_SERIES = "OTHER_EVENT_SERIES"
    OTHER_EVENT = "OTHER_EVENT"
  }

  native_enum Language {
    fi = "fi"
    en = "en"
    sv = "sv"
    OTHER = "OTHER"
  }

  native_enum Openness {
    OPEN = "OPEN"
    TARGETED = "TARGETED"
    INVITE_ONLY = "INVITE_ONLY"
  }

  native_enum RelatedLarpType {
    SEQUEL = "SEQUEL"
    SPINOFF = "SPINOFF"
    // CAMPAIGN_LARP IN_CAMPAIGN CAMPAIGN, ONE_SHOT RUN_OF MULTIPLE_RUNS etc.
    IN_CAMPAIGN = "IN_CAMPAIGN"
    IN_SERIES = "IN_SERIES"
    RUN_OF = "RUN_OF"
    RERUN_OF = "RERUN_OF"
    PLAYED_AT = "PLAYED_AT"
  }

  // Postgres only appends enum values, so the order here is the order they were added in.
  native_enum RelatedUserRole {
    EDITOR = "EDITOR"
    CREATED_BY = "CREATED_BY"
    GAME_MASTER = "GAME_MASTER"
    VOLUNTEER = "VOLUNTEER"
    PLAYER = "PLAYER"
    FAVORITE = "FAVORITE"
    TEAM_MEMBER = "TEAM_MEMBER"
    LOCAL_SIGNUP_YES = "LOCAL_SIGNUP_YES"
    LOCAL_SIGNUP_MAYBE = "LOCAL_SIGNUP_MAYBE"
    LOCAL_SIGNUP_NO = "LOCAL_SIGNUP_NO"
  }

  native_enum LocalSignupStatus {
    DISABLED = "DISABLED"
    PUBLIC = "PUBLIC"
    CODE_REQUIRED = "CODE_REQUIRED"
  }

  native_enum RelatedUserVisibility {
    PARTICIPANTS = "PARTICIPANTS"
    GM = "GM"
    ONLY_ME = "ONLY_ME"
  }

  native_enum LarpLinkType {
    HOMEPAGE = "HOMEPAGE"
    PHOTOS = "PHOTOS"
    SOCIAL_MEDIA = "SOCIAL_MEDIA"
    PLAYER_GUIDE = "PLAYER_GUIDE"
    OTHER = "OTHER"
    SIGNUP = "SIGNUP"
    SOURCE = "SOURCE"
  }

  native_enum SubmitterRole {
    NONE = "NONE"
    GAME_MASTER = "GAME_MASTER"
    VOLUNTEER = "VOLUNTEER"
    PLAYER = "PLAYER"
    TEAM_MEMBER = "TEAM_MEMBER"
  }

  native_enum EditStatus {
    PENDING_VERIFICATION = "PENDING_VERIFICATION"
    VERIFIED = "VERIFIED"
    AUTO_APPROVED = "AUTO_APPROVED"
    APPROVED = "APPROVED"
    REJECTED = "REJECTED"
    WITHDRAWN = "WITHDRAWN"
  }

  native_enum EditAction {
    CREATE = "CREATE"
    UPDATE = "UPDATE"
    CLAIM = "CLAIM"
    DELETE = "DELETE"
  }

  native_enum HeaderImageSource {
    UPLOAD = "UPLOAD"
    // Reserved for pictures picked from larppikuvat.fi; nothing writes it yet.
    LARPPIKUVAT = "LARPPIKUVAT"
  }

  model User {
    id                      Uuid                        @id @onCreate(uuid(4))
    name                    String?
    email                   String                      @unique
    // Set when the user first submits a request and verifies it. Independent of role:
    // role=VERIFIED means a moderator approved a request, granting the power to add larps
    // without pre-moderation.
    emailVerified           TimestamptzString?          @map("email_verified")
    image                   String?
    createdAt               TimestamptzString           @default(now()) @map("created_at")
    updatedAt               TimestamptzString   @onCreate(now()) @onUpdate(now()) @map("updated_at")

    titleFi                 String?                     @map("title_fi")
    titleEn                 String?                     @map("title_en")

    role                    pg.enum(UserRole)           @default("NOT_VERIFIED")
    editFormPreference      pg.enum(EditFormPreference) @default("FULL") @map("edit_form_preference")

    accounts                Account[]
    larps                   RelatedUser[]
    requestsResolvedByUser  ModerationRequest[]         @relation("RequestsResolvedByUser")
    requestsSubmittedByUser ModerationRequest[]         @relation("RequestsSubmittedByUser")
    headerImages            HeaderImage[]               @relation("HeaderImagesUploadedByUser")

    @@map("user")
  }

  // One row per Kompassi identity, linking the OIDC subject to the larpit.fi user.
  model Account {
    userId            Uuid                       @map("user_id")
    type              String
    provider          String
    providerAccountId String                     @map("provider_account_id")
    refreshToken      String?                    @map("refresh_token")
    accessToken       String?                    @map("access_token")
    expiresAt         Int?                       @map("expires_at")
    tokenType         String?                    @map("token_type")
    scope             String?
    idToken           String?                    @map("id_token")
    sessionState      String?                    @map("session_state")

    createdAt         TimestamptzString          @default(now()) @map("created_at")
    updatedAt         TimestamptzString  @onCreate(now()) @onUpdate(now()) @map("updated_at")

    user              User                       @relation(fields:[userId], references:[id], onDelete: Cascade, index: false)

    @@id([provider, providerAccountId])
    @@map("account")
  }

  model VerificationToken {
    identifier String
    token      String
    expires    TimestamptzString
    type       pg.enum(TokenType) @default("EMAIL_VERIFICATION")

    @@id([identifier, token])
    @@map("verification_token")
  }

  model Country {
    // Wikidata id with wd: prefix, eg. wd:Q33
    id             String         @id
    // ISO 3166-1 alpha-2 country code, eg. FI
    code           String?        @unique
    nameFi         String?        @map("name_fi")
    nameSv         String?        @map("name_sv")
    nameEn         String?        @map("name_en")
    municipalities Municipality[]

    @@map("country")
  }

  model Municipality {
    id                    String  @id
    nameFi                String? @map("name_fi")
    nameSv                String? @map("name_sv")
    nameOther             String? @map("name_other")
    nameOtherLanguageCode String? @map("name_other_language_code")
    countryId             String  @default("wd:Q33") @map("country_code")
    lat                   Float
    long                  Float
    larps                 Larp[]

    country               Country @relation(fields:[countryId], references:[id], onDelete: Cascade, index: false)

    @@map("municipality")
  }

  model Larp {
    // createdAt is derived from the UUIDv7 id
    id                     Uuid                           @id @default(sql`uuidv7()`)
    name                   String
    type                   pg.enum(LarpType)              @default("ONE_SHOT")
    language               pg.enum(Language)
    tagline                String?
    alias                  String?                        @unique

    locationText           String?                        @map("location_text")
    municipalityId         String?                        @map("municipality_id")

    numPlayerCharacters    Int?                           @map("num_player_characters")
    numTotalParticipants   Int?                           @map("num_total_participants")

    fluffText              String?                        @map("fluff_text")
    description            String?

    updatedAt              TimestamptzString      @onCreate(now()) @onUpdate(now()) @map("updated_at")

    startsAt               DateString?                    @map("starts_at")
    endsAt                 DateString?                    @map("ends_at")
    signupStartsAt         DateString?                    @map("signup_starts_at")
    signupEndsAt           DateString?                    @map("signup_ends_at")
    openness               pg.enum(Openness)?

    localSignupStatus      pg.enum(LocalSignupStatus)     @default("DISABLED") @map("local_signup_status")
    localSignupCode        String?                        @map("local_signup_code")
    relatedUserVisibility  pg.enum(RelatedUserVisibility) @default("GM") @map("related_user_visibility")

    cancelledAt            TimestamptzString?             @map("cancelled_at")
    updateCount            Int                            @default(0) @map("update_count")
    headerImageId          Uuid?                          @map("header_image_id")

    links                  LarpLink[]
    relatedLarpsLeft       RelatedLarp[]                  @relation("RelatedLarpsLeft")
    relatedLarpsRight      RelatedLarp[]                  @relation("RelatedLarpsRight")
    relatedUsers           RelatedUser[]
    unauthenticatedSignups UnauthenticatedSignup[]
    requests               ModerationRequest[]
    aliasRedirects         LarpAliasRedirect[]
    municipality           Municipality?                  @relation(fields:[municipalityId], references:[id], onDelete: SetNull, index: false)
    headerImage            HeaderImage?                   @relation(fields:[headerImageId], references:[id], onDelete: SetNull, index: false)

    @@fullTextIndex([name, tagline, description, fluffText], language: "finnish", where: sql`language = 'fi'`, name: "larp_search_fi")
    @@fullTextIndex([name, tagline, description, fluffText], language: "english", where: sql`language = 'en'`, name: "larp_search_en")
    @@fullTextIndex([name, tagline, description, fluffText], language: "swedish", where: sql`language = 'sv'`, name: "larp_search_sv")
    @@fullTextIndex([name, tagline, description, fluffText], language: "simple", where: sql`language = 'OTHER'`, name: "larp_search_other")
    @@map("larp")
  }

  model RelatedLarp {
    leftId  Uuid                     @map("left_id")
    rightId Uuid                     @map("right_id")
    type    pg.enum(RelatedLarpType)

    left    Larp                     @relation("RelatedLarpsLeft", fields:[leftId], references:[id], onDelete: Cascade, index: false)
    right   Larp                     @relation("RelatedLarpsRight", fields:[rightId], references:[id], onDelete: Cascade, index: false)

    @@id([leftId, rightId])
    @@map("related_larp")
  }

  model RelatedUser {
    larpId     Uuid                           @map("larp_id")
    userId     Uuid                           @map("user_id")
    role       pg.enum(RelatedUserRole)
    visibility pg.enum(RelatedUserVisibility) @default("ONLY_ME")
    createdAt  TimestamptzString              @default(now()) @map("created_at")

    larp       Larp                           @relation(fields:[larpId], references:[id], onDelete: Cascade, index: false)
    user       User                           @relation(fields:[userId], references:[id], onDelete: Cascade, index: false)

    @@id([larpId, userId, role])
    @@map("related_user")
  }

  model LarpLink {
    id     Uuid                  @id @default(sql`uuidv7()`)
    larpId Uuid                  @map("larp_id")
    type   pg.enum(LarpLinkType) @default("HOMEPAGE")
    href   String
    title  String?

    larp   Larp                  @relation(fields:[larpId], references:[id], onDelete: Cascade, index: false)

    @@map("larp_link")
  }

  model ModerationRequest {
    id                 Uuid                   @id @default(sql`uuidv7()`)
    larpId             Uuid?                  @map("larp_id")
    action             pg.enum(EditAction)
    status             pg.enum(EditStatus)

    resolvedById       Uuid?                  @map("resolved_by_id")
    resolvedAt         TimestamptzString?     @map("resolved_at")
    resolvedMessage    String?                @map("resolved_message")

    submitterName      String                 @map("submitter_name")
    submitterEmail     String                 @map("submitter_email")
    submitterId        Uuid?                  @map("submitter_id")
    submitterRole      pg.enum(SubmitterRole) @default("NONE") @map("submitter_role")

    verificationCode   Uuid?                  @unique @default(sql`gen_random_uuid()`) @map("verification_code")
    verifiedAt         TimestamptzString?     @map("verified_at")

    newContent         Jsonb                  @default(sql`'{}'::jsonb`) @map("new_content")

    removeLinks        Jsonb                  @default(sql`'[]'::jsonb`) @map("remove_links")
    addLinks           Jsonb                  @default(sql`'[]'::jsonb`) @map("add_links")

    removeRelatedLarps Jsonb                  @default(sql`'[]'::jsonb`) @map("remove_related_larps")
    addRelatedLarps    Jsonb                  @default(sql`'[]'::jsonb`) @map("add_related_larps")

    message            String?

    larp               Larp?                  @relation(fields:[larpId], references:[id], onDelete: Cascade, index: false)
    // Removing a user keeps their moderation history: submitterName/submitterEmail are
    // denormalized, only the FK is dropped.
    resolvedBy         User?                  @relation("RequestsResolvedByUser", fields:[resolvedById], references:[id], onDelete: SetNull, index: false)
    submitter          User?                  @relation("RequestsSubmittedByUser", fields:[submitterId], references:[id], onDelete: SetNull, index: false)

    @@map("moderation_request")
  }

  // An alias that a larp no longer has, kept so that links to it still lead to the larp. A larp
  // that takes the same alias wins over the redirect.
  model LarpAliasRedirect {
    alias     String            @id
    larpId    Uuid              @map("larp_id")
    createdAt TimestamptzString @default(now()) @map("created_at")

    larp      Larp              @relation(fields:[larpId], references:[id], onDelete: Cascade)

    @@map("larp_alias_redirect")
  }

  model Page {
    slug      String                     @default("front-page")
    language  String
    title     String
    ingress   String                     @default("")
    content   String
    menuPosition Int?                    @map("menu_position")
    createdAt TimestamptzString          @default(now()) @map("created_at")
    updatedAt TimestamptzString  @onCreate(now()) @onUpdate(now()) @map("updated_at")
    headerImageId Uuid?                  @map("header_image_id")

    headerImage HeaderImage?             @relation(fields:[headerImageId], references:[id], onDelete: SetNull, index: false)

    @@id([slug, language])
    @@fullTextIndex([title, ingress, content], language: "finnish", where: sql`language = 'fi'`, name: "page_search_fi")
    @@fullTextIndex([title, ingress, content], language: "english", where: sql`language = 'en'`, name: "page_search_en")
    @@map("page")
  }

  // Command palette entries in one UI language, searched by label and synonyms. Rows with
  // isBuiltin are rewritten from the translations at startup; other rows are left alone.
  model Command {
    id        Uuid    @id @default(sql`uuidv7()`)
    language  String
    // A slug such as `larp:editLarp` that the palette implements, or a URL template such as
    // `/larp/{larpId}/roles`.
    action    String
    label     String
    // One synonym per line.
    synonyms  String  @default("")
    isBuiltin Boolean @default(false) @map("is_builtin")

    @@unique([language, action])
    @@fullTextIndex([label, synonyms], language: "finnish", where: sql`language = 'fi'`, name: "command_search_fi")
    @@fullTextIndex([label, synonyms], language: "english", where: sql`language = 'en'`, name: "command_search_en")
    @@map("command")
  }

  model UnauthenticatedSignup {
    id               Uuid                           @id @default(sql`uuidv7()`)
    larpId           Uuid                           @map("larp_id")
    displayName      String                         @map("display_name")
    email            String
    signupStatus     pg.enum(RelatedUserRole)       @map("signup_status")
    visibility       pg.enum(RelatedUserVisibility)
    verificationCode String                         @unique @map("verification_code")
    verifiedAt       TimestamptzString?             @map("verified_at")
    createdAt        TimestamptzString              @default(now()) @map("created_at")
    updatedAt        TimestamptzString      @onCreate(now()) @onUpdate(now()) @map("updated_at")

    larp             Larp                           @relation(fields:[larpId], references:[id], onDelete: Cascade, index: false)

    // At most one pending and one verified signup per email and larp.
    @@index([larpId, email], map: "unauthenticated_signup_larp_email_pending_uidx", where: sql`(verified_at IS NULL)`, unique: true)
    @@index([larpId, email], map: "unauthenticated_signup_larp_email_verified_uidx", where: sql`(verified_at IS NOT NULL)`, unique: true)
    @@check(expression: sql`(signup_status = ANY (ARRAY['LOCAL_SIGNUP_YES'::"RelatedUserRole", 'LOCAL_SIGNUP_MAYBE'::"RelatedUserRole", 'LOCAL_SIGNUP_NO'::"RelatedUserRole"]))`, map: "unauthenticated_signup_signup_status_check")
    @@check(expression: sql`(visibility = ANY (ARRAY['PARTICIPANTS'::"RelatedUserVisibility", 'GM'::"RelatedUserVisibility"]))`, map: "unauthenticated_signup_visibility_check")
    @@map("unauthenticated_signup")
  }

  model HeaderImage {
    id                   Uuid                         @id @default(sql`uuidv7()`)
    source               pg.enum(HeaderImageSource)   @default("UPLOAD")
    larppikuvatPictureId String?                      @map("larppikuvat_picture_id")
    contentType          String                       @map("content_type")
    // Pixel size of the original after EXIF rotation.
    width                Int
    height               Int
    // Fractions (0..1) of the EXIF-rotated original's width and height.
    cropX                Float                        @map("crop_x")
    cropY                Float                        @map("crop_y")
    cropWidth            Float                        @map("crop_width")
    cropHeight           Float                        @map("crop_height")
    revision             Int                          @default(1)
    photographerCredit   String                       @map("photographer_credit")
    uploadedById         Uuid?                        @map("uploaded_by_id")
    createdAt            TimestamptzString            @default(now()) @map("created_at")
    updatedAt            TimestamptzString    @onCreate(now()) @onUpdate(now()) @map("updated_at")

    uploadedBy           User?                        @relation("HeaderImagesUploadedByUser", fields:[uploadedById], references:[id], onDelete: SetNull, index: false)
    larps                Larp[]
    pages                Page[]

    @@map("header_image")
  }

  // Used by the calendar view.
  model Holiday {
    date    DateString @id
    titleFi String     @map("title_fi")
    titleEn String     @map("title_en")

    @@map("holiday")
  }
}
